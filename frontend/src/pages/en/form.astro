---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/Form/ContactForm';

const labels = {
  name: 'Name',
  email: 'Email',
  message: 'Message',
  submit: 'Submit Form'
};

const messages = {
  emailRequired: 'Please enter your email address',
  emailMissingAt: 'Email address must contain the @ symbol',
  emailMissingDomain: 'Email address must include a valid domain (e.g. example.com)',
  emailInvalidTld: 'Domain suffix is invalid (e.g. .com, .org, etc.)',
  emailInvalidFormat: 'Please enter a valid email address format',
  success: 'Thank you for your message! We will get back to you soon.'
};
---

<Layout title="Contact Us - ModernAstro" lang="en">
  <div class="form-page">
    <div class="form-header">
      <h1>Contact Us</h1>
      <p>If you have any questions, please fill out the form below.</p>
    </div>
    <ContactForm client:load labels={labels} messages={messages} />
  </div>
</Layout>

<style lang="less">
  @import '../../styles/variables.less';

  .form-page {
    .container();
    padding: 60px 20px;

    .form-header {
      text-align: center;
      margin-bottom: 40px;

      h1 {
        margin-bottom: 16px;
      }
      
      p {
        color: @text-secondary;
      }
    }
  }
</style>
