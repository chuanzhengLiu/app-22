---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/Form/ContactForm';

const labels = {
  name: 'Name',
  email: 'Email',
  message: 'Message',
  submit: 'Submit Form'
};
---

<Layout title="Contact Us - ModernAstro" lang="en">
  <div class="form-page">
    <div class="form-header">
      <h1>Contact Us</h1>
      <p>If you have any questions, please fill out the form below.</p>
    </div>
    <ContactForm client:load labels={labels} />
  </div>
</Layout>

<style lang="less">
  @import '../../styles/variables.less';

  .form-page {
    .container();
    padding: 60px 20px;

    .form-header {
      text-align: center;
      margin-bottom: 40px;

      h1 {
        margin-bottom: 16px;
      }
      
      p {
        color: @text-secondary;
      }
    }
  }
</style>
