---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Profile - ModernAstro" lang="en">
  <div class="profile-container">
    <div class="profile-card">
      <div class="avatar">MA</div>
      <h2>User Name</h2>
      <p class="role">Senior Developer</p>
      <div class="stats">
        <div class="stat">
          <span class="value">12</span>
          <span class="label">Projects</span>
        </div>
        <div class="stat">
          <span class="value">5.2k</span>
          <span class="label">Followers</span>
        </div>
        <div class="stat">
          <span class="value">128</span>
          <span class="label">Contribs</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style lang="less">
  @import '../../styles/variables.less';

  .profile-container {
    .container();
    padding: 80px 20px;
    display: flex;
    justify-content: center;
  }

  .profile-card {
    background: @surface-color;
    padding: 48px;
    border-radius: @radius-lg;
    box-shadow: @shadow-xl;
    text-align: center;
    width: 100%;
    max-width: 400px;
    border-top: 4px solid @accent-color;

    .avatar {
      width: 100px;
      height: 100px;
      background: @gradient-primary;
      border-radius: 50%;
      margin: 0 auto 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 32px;
      font-weight: bold;
    }

    h2 {
      margin-bottom: 8px;
    }

    .role {
      color: @accent-color;
      font-weight: 500;
      margin-bottom: 32px;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      border-top: 1px solid @border-color;
      padding-top: 24px;

      .stat {
        display: flex;
        flex-direction: column;
        
        .value {
          font-size: 20px;
          font-weight: 700;
          color: @primary-color;
        }
        
        .label {
          font-size: 12px;
          color: @text-secondary;
          text-transform: uppercase;
          margin-top: 4px;
        }
      }
    }
  }
</style>
